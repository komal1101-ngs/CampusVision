# ============================================================
# BACKEND ONLY (Render environment variables — never expose to frontend)
# ============================================================
PORT=5000
NODE_ENV=development
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ============================================================
# FRONTEND ONLY (Vercel environment variables — safe to use in browser)
# ============================================================
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Local development (uses Vite proxy — points to local backend):
VITE_API_BASE_URL=http://localhost:5000/api

# VITE_API_BASE_URL=https://campusvision-1.onrender.com/api
